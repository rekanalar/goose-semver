    intersects_case("<3.0.2 3.2.0 || <=3 || ^* ~1.2.x", "~>0.2.1 =0.3.0 > 3.1.2 || 1.1 ^2.1.0 <2.2.1-rc.1", false);
    intersects_case("", "*", true);
