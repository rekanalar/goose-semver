// Cases made by test/make_npm_cases.js with npm semver 7.6.1.
// Do not edit by hand. Make the file again with the script.
// The file holds 1510 cases.

namespace npm_cases;

import std;
import semver from "..";

// Each list is a text of versions with a space between them.

fn want_place(vs: const u8[:][:], at: i64, want: const u8[:]) {
    if want == "null" {
        assert(at == -1);
    } else {
        assert(at >= 0 && at < vs.len);
        assert(vs[at] == want);
    }
}

fn select_case(list: const u8[:], range: const u8[:], mx: const u8[:], mn: const u8[:]) {
    let vs = words(list);
    want_place(vs[..], semver::max_satisfying(vs[..], range), mx);
    want_place(vs[..], semver::min_satisfying(vs[..], range), mn);
}

fn join_places(vs: const u8[:][:], order: i64[>..]&) -> u8[>..] {
    var s: u8[>..] = [];
    for p, i in order {
        if i > 0 { s.push(' '); }
        s.append(vs[p]);
    }
    return s;
}

fn sort_case(list: const u8[:], asc: const u8[:], desc: const u8[:]) {
    let vs = words(list);
    var order: i64[>..] = [];
    semver::sort(order, vs[..]);
    assert(order.len == vs.len);
    let a = join_places(vs[..], order);
    assert(a[..] == asc);
    semver::rsort(order, vs[..]);
    assert(order.len == vs.len);
    let d = join_places(vs[..], order);
    assert(d[..] == desc);
}

fn compare_case(a: const u8[:], b: const u8[:], cb: i64, g: bool, ge: bool, l: bool, le: bool, e: bool, ne: bool) {
    let x, ok1 = semver::parse(a);
    let y, ok2 = semver::parse(b);
    assert(ok1 && ok2);
    assert(semver::compare_build(x, y) == cb);
    assert(semver::gt(x, y) == g);
    assert(semver::gte(x, y) == ge);
    assert(semver::lt(x, y) == l);
    assert(semver::lte(x, y) == le);
    assert(semver::eq(x, y) == e);
    assert(semver::neq(x, y) == ne);
}

fn minversion_case(range: const u8[:], want: const u8[:]) {
    var out: u8[>..] = [];
    let ok = semver::min_version(out, range);
    if want == "null" {
        assert(!ok);
        assert(out.len == 0);
    } else {
        assert(ok);
        assert(out[..] == want);
    }
}

fn intersects_case(a: const u8[:], b: const u8[:], want: bool) {
    assert(semver::intersects(a, b) == want);
}

fn subset_case(a: const u8[:], b: const u8[:], want: bool) {
    assert(semver::subset(a, b) == want);
}

fn valid_case(s: const u8[:], want: const u8[:]) {
    var out: u8[>..] = [];
    let ok = semver::valid(out, s);
    if want == "null" {
        assert(!ok);
        assert(out.len == 0);
    } else {
        assert(ok);
        assert(out[..] == want);
    }
}

fn join_parts(parts: const u8[:][:]) -> u8[>..] {
    var s: u8[>..] = [];
    join(s, parts, " ");
    return s;
}

fn accessor_case(s: const u8[:], ma: i64, mi: i64, pa: i64, pre: const u8[:]) {
    let a, ok1 = semver::major(s);
    let b, ok2 = semver::minor(s);
    let c, ok3 = semver::patch(s);
    assert(ok1 && ok2 && ok3);
    assert(a == ma && b == mi && c == pa);
    var parts: const u8[:][>..] = [];
    let ok4 = semver::prerelease(parts, s);
    if pre == "null" {
        assert(!ok4);
        assert(parts.len == 0);
    } else {
        assert(ok4);
        assert(join_parts(parts)[..] == pre);
    }
}

fn compare_text_case(a: const u8[:], b: const u8[:], c: i64, rc: i64, loose: i64) {
    assert(semver::compare_text(a, b) == c);
    assert(semver::rcompare(a, b) == rc);
    assert(semver::compare_loose(a, b) == loose);
}

fn ident_case(a: const u8[:], b: const u8[:], c: i64, rc: i64) {
    assert(semver::compare_identifiers(a, b) == c);
    assert(semver::rcompare_identifiers(a, b) == rc);
}

fn cmp_case(a: const u8[:], op: const u8[:], b: const u8[:], want: bool) {
    assert(semver::cmp(a, op, b) == want);
}

fn comparators_case(range: const u8[:], want: const u8[:]) {
    var norm: u8[>..] = [];
    var parts: const u8[:][>..] = [];
    var ends: i64[>..] = [];
    let ok = semver::to_comparators(norm, parts, ends, range);
    assert(ok);
    // The sets go out one after the other.
    var got: u8[>..] = [];
    var at: i64 = 0;
    var i: i64 = 0;
    while i < ends.len {
        if i > 0 { got.push('|'); }
        var j: i64 = at;
        while j < ends[i] {
            if j > at { got.push(' '); }
            got.append(parts[j]);
            j += 1;
        }
        at = ends[i];
        i += 1;
    }
    assert(got[..] == want);
}

fn simplify_case(versions: const u8[:], range: const u8[:], want: const u8[:]) {
    let vs = words(versions);
    var out: u8[>..] = [];
    let ok = semver::simplify_range(out, vs[..], range);
    assert(ok);
    assert(out[..] == want);
}

fn outside_case(v: const u8[:], range: const u8[:], hi: bool, lo: bool) {
    let x, ok = semver::parse(v);
    assert(ok);
    assert(semver::gtr(x, range) == hi);
    assert(semver::ltr(x, range) == lo);
    assert(semver::outside(x, range, ">") == hi);
    assert(semver::outside(x, range, "<") == lo);
}

